---

<Layout
  title="David Vargas — AI Systems Engineer | Self-Hosted AI & GPU Optimization"
  description="AI Systems Engineer from Guatemala specializing in self-hosted AI systems, GPU optimization, and production ML infrastructure. Building Kurai-Transcribe, KuraiMusik, and KurAI2Video - zero-cost AI solutions that scale."
>
  <!-- Three.js Background -->
  <canvas id="webgl-canvas" aria-hidden="true"></canvas>



  <Header />

  <main>
    <!-- Hero Section -->
    <section class="hero-brutal" aria-label="Introducción">
      <div class="hero-content">
        <div class="hero-label">
          <span class="bracket">[</span>AI SYSTEMS ENGINEER<span class="bracket"
            >]</span
          >
        </div>
        <h1 class="hero-title">
          BUILDING<br />
          AI SYSTEMS<br />
          THAT SCALE
        </h1>
        <div class="hero-subtitle">
          AI Infrastructure · GPU Optimization · ML Pipelines
        </div>
        <div class="hero-cta">
          <a href="#work" class="btn-brutal btn-primary">SEE WORK</a>
          <a
            href="https://github.com/DavidDevGt"
            target="_blank"
            rel="noopener"
            class="btn-brutal">GITHUB →</a
          >
        </div>
      </div>
      <div class="hero-side">
        <div class="stats-brutal">
          <div class="stat">
            <div class="stat-value">3+</div>
            <div class="stat-label">YEARS EXPERIENCE</div>
          </div>
          <div class="stat">
            <div class="stat-value">$0</div>
            <div class="stat-label">VENDOR LOCK-IN</div>
          </div>
          <div class="stat">
            <div class="stat-value">24/7</div>
            <div class="stat-label">AUTONOMOUS OPERATION</div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section class="section-brutal about-section">
      <div class="section-header">
        <span class="section-number">[01]</span>
        <h2 class="section-title">WHO</h2>
      </div>
      <div class="about-content">
        <p class="about-text">
          Software Engineer specialized in AI systems, building self-hosted
          infrastructure, scalable backend/frontend applications, and
          production-ready machine learning pipelines. I focus on creating
          systems that operate independently, avoid vendor lock-in, and maintain
          full data control.
        </p>

        <p class="about-text">
          My expertise covers the full lifecycle: from GPU-optimized model
          deployment and high-performance APIs to CI/CD pipelines, monitoring,
          and automated testing. I design systems with reliability, scalability,
          and quality at the core, integrating strong QA practices across every
          layer.
        </p>

         <p class="about-text">
          Projects like Kurai-Transcribe, KuraiMusik, and KurAI2Video reflect
          this approach—AI systems running 24/7 with zero API costs, optimized
          performance, and production-grade stability, combining advanced AI
          capabilities with solid engineering and automation.
        </p>
        <div class="about-highlights">
          <div class="highlight">
            <div class="highlight-icon">▲</div>
            <div class="highlight-text">
              Self-hosted AI: Zero API costs, complete data sovereignty, full
              control
            </div>
          </div>
          <div class="highlight">
            <div class="highlight-icon">▲</div>
            <div class="highlight-text">
              GPU optimization: CUDA, memory management, performance tuning for
              AI workloads
            </div>
          </div>
          <div class="highlight">
            <div class="highlight-icon">▲</div>
            <div class="highlight-text">
              Production systems: CI/CD, monitoring, and scalable deployments
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Experience Section -->
  <section class="section-brutal" id="experience">
    <div class="section-header">
      <span class="section-number">[02]</span>
      <h2 class="section-title">EXPERIENCE</h2>
    </div>
    <div class="experience-timeline">
      {
        experience.map((exp) => (
          <div class="experience-item">
            <div class="experience-header">
              <h3 class="experience-role">{exp.role}</h3>
              <div class="experience-meta">
                <span class="experience-company">{exp.company}</span>
                <span class="experience-period">{exp.period}</span>
              </div>
            </div>
            <ul class="experience-achievements">
              {exp.achievements.map((achievement) => (
                <li class="achievement-item">
                  <span class="achievement-bullet">▸</span>
                  {achievement}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Projects Section -->
  <section class="section-brutal" id="work">
    <div class="section-header">
      <span class="section-number">[03]</span>
      <h2 class="section-title">WORK</h2>
    </div>
    <div class="projects-brutal">
       {
         projects.map((project, idx) => (
           <article class="project-brutal" data-project-id={`project_${idx + 1}`} data-project-name={project.title}>
             <div class="project-number">
               [{String(idx + 1).padStart(2, "0")}]
             </div>
            <div class="project-main">
              <div class="project-header">
                <h3 class="project-title">{project.title}</h3>
                <span class="project-year">{project.year}</span>
              </div>
              <p class="project-desc">{project.desc}</p>
              <div class="project-stack">
                {project.stack.map((tech) => (
                  <span class="tech-tag">{tech}</span>
                ))}
              </div>
              {project.link && (
                <div class="project-footer">
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project-link"
                  >
                    VIEW LIVE →
                  </a>
                  <span class="project-metric">{project.metrics}</span>
                </div>
              )}
              {!project.link && project.metrics && (
                <div class="project-footer">
                  <span class="project-metric">{project.metrics}</span>
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Stack Section -->
  <section class="section-brutal" id="stack">
    <div class="section-header">
      <span class="section-number">[04]</span>
      <h2 class="section-title">STACK</h2>
    </div>
    <div class="stack-grid">
      {
        Object.entries(skills).map(([category, techs]) => (
          <div class="stack-category">
            <h3 class="stack-category-title">{category}</h3>
            <ul class="stack-list">
              {techs.map((tech) => (
                <li class="stack-item">
                  <span class="stack-bullet">▸</span>
                  {tech}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section-brutal contact-section" id="contact">
    <div class="section-header">
      <span class="section-number">[05]</span>
      <h2 class="section-title">CONTACT</h2>
    </div>
    <div class="contact-content">
      <div class="contact-text">
        <p>
          Available for AI infrastructure consulting and development projects.
        </p>
        <p>
          Specializing in self-hosted AI systems, MLOps platforms, and
          production ML infrastructure.
        </p>
        <p>Let's build AI systems that actually work at scale.</p>
      </div>
      <div class="contact-links">
        <a
          href="https://github.com/DavidDevGt"
          target="_blank"
          rel="noopener"
          class="contact-link"
        >
          <span class="link-label">GITHUB</span>
          <span class="link-arrow">→</span>
        </a>
        <a
          href="https://www.linkedin.com/in/jdavidvl/"
          target="_blank"
          rel="noopener"
          class="contact-link"
        >
          <span class="link-label">LINKEDIN</span>
          <span class="link-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
</Layout>

<Footer />

<script>
  import { ThreeScene } from '../scripts/three-scene';
  import { GSAPAnimations } from '../scripts/gsap-animations';
  import { UmamiBatcher, logUmamiDetails, checkUmamiHealth } from '../scripts/analytics-umami';

  let threeScene: ThreeScene | null = null;
  let gsapAnimations: GSAPAnimations | null = null;
  let analytics: any = null;
  let umamiBatcher: any = null;

  // Initialize everything when DOM is ready
  if (typeof window !== "undefined") {
    const initAll = async () => {
      try {
        // Initialize Umami Batcher first (antes de analytics)
        umamiBatcher = new UmamiBatcher();
        
        // Initialize Analytics
        const { Analytics } = await import('../scripts/analytics');
        analytics = new Analytics(true);
        analytics.trackPageView(window.location.pathname);
        
        // Log Umami status
        setTimeout(() => {
          const health = checkUmamiHealth();
          if (health.loaded) {
            console.log('✅ [Umami] Cloud Analytics Connected');
            logUmamiDetails();
          } else {
            console.warn('⚠️ [Umami] Script still loading...');
          }
        }, 2000);
        
        // Initialize GSAP animations
        gsapAnimations = new GSAPAnimations();
        gsapAnimations.init();

        // Initialize Three.js scene
        threeScene = new ThreeScene({
          canvasId: 'webgl-canvas'
        });
        await threeScene.init();

        // Setup analytics event listeners
        setupAnalyticsTracking(analytics);
        setupScrollTracking(analytics);
        setupProjectTracking(analytics);
        setupNavigationTracking(analytics);
        setupSectionTracking(analytics);
      } catch (error) {
        console.warn("Failed to initialize:", error);
      }
    };

    /**
      * Setup tracking para clicks generales
      */
    const setupAnalyticsTracking = (ana: any) => {
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        
        // Track CTA buttons
        if (target.classList.contains('btn-brutal') || target.classList.contains('btn-primary')) {
          const ctaText = target.textContent?.trim() || 'button_click';
          ana.trackCTA(ctaText, 'click');
          
          // Send to Umami
          const event = ana.getEvents()?.find((ev: any) => ev.type === 'cta_interaction');
          if (event && umamiBatcher) {
            umamiBatcher.addEvent(event);
          }
        }

        // Track external links
        if (target.tagName === 'A') {
          const href = (target as HTMLAnchorElement).href;
          if (href && !href.includes(window.location.hostname)) {
            ana.trackExternalLink(href, target.textContent?.trim() || 'link');
            
            // Send to Umami
            const event = ana.getEvents()?.find((ev: any) => ev.type === 'external_link');
            if (event && umamiBatcher) {
              umamiBatcher.addEvent(event);
            }
          }
        }

        // Track general clicks for debugging
        if (target.id) {
          ana.trackClick(target, 'element_click');
        }
      }, true);
    };

    /**
      * Setup scroll depth tracking
      */
    const setupScrollTracking = (ana: any) => {
      let scrollTimeout: NodeJS.Timeout;
      
      window.addEventListener('scroll', () => {
        clearTimeout(scrollTimeout);
        
        // Calculate scroll depth percentage
        const windowHeight = window.innerHeight;
        const documentHeight = document.documentElement.scrollHeight;
        const scrollTop = window.scrollY;
        
        const scrollDepth = Math.round(
          ((scrollTop + windowHeight) / documentHeight) * 100
        );
        
        ana.trackScrollDepth(scrollDepth);
        
        // Send to Umami on milestone
        if (scrollDepth === 25 || scrollDepth === 50 || scrollDepth === 75 || scrollDepth === 100) {
          if (typeof window.umami !== 'undefined') {
            window.umami.track('scroll_depth', { depth: scrollDepth, percentage: `${scrollDepth}%` });
          }
        }
        
        // Debounce logging
        scrollTimeout = setTimeout(() => {
          console.log(`📊 Scroll Depth: ${scrollDepth}%`, {
            scrollTop,
            windowHeight,
            documentHeight,
          });
        }, 1000);
      }, { passive: true });
    };

    /**
      * Setup project click tracking
      */
    const setupProjectTracking = (ana: any) => {
      const projectCards = document.querySelectorAll('[data-project-id]');
      
      projectCards.forEach((card) => {
        const projectId = card.getAttribute('data-project-id');
        const projectName = card.getAttribute('data-project-name');
        
        // Track card click
        card.addEventListener('click', () => {
          if (projectId && projectName) {
            ana.trackProjectClick(projectId, projectName, 'card_click');
            
            // Send to Umami
            if (typeof window.umami !== 'undefined') {
              window.umami.track('project_click', {
                project_id: projectId,
                project_name: projectName,
                action: 'card_click'
              });
            }
            
            console.log(`🎯 Project Clicked: ${projectName} (${projectId})`);
          }
        });

        // Track project link click
        const projectLink = card.querySelector('.project-link');
        if (projectLink) {
          projectLink.addEventListener('click', (e) => {
            e.stopPropagation();
            if (projectId && projectName) {
              ana.trackProjectClick(projectId, projectName, 'view_live_click');
              const href = (projectLink as HTMLAnchorElement).href;
              ana.trackExternalLink(href, `${projectName}_view_live`);
              
              // Send to Umami
              if (typeof window.umami !== 'undefined') {
                window.umami.track('project_click', {
                  project_id: projectId,
                  project_name: projectName,
                  action: 'view_live_click'
                });
                window.umami.track('outbound_link', {
                  url: href,
                  domain: new URL(href).hostname,
                  label: `${projectName}_view_live`
                });
              }
              
              console.log(`🔗 Project Link Clicked: ${projectName} → ${href}`);
            }
          });
        }
      });
    };

    /**
      * Setup navigation link tracking
      */
    const setupNavigationTracking = (ana: any) => {
      const navLinks = document.querySelectorAll('.nav-link');
      
      navLinks.forEach((link) => {
        link.addEventListener('click', () => {
          const href = (link as HTMLAnchorElement).href;
          const sectionName = link.textContent?.trim() || 'navigation';
          ana.trackEvent('navigation', 'click', sectionName, { href });
          
          // Send to Umami
          if (typeof window.umami !== 'undefined') {
            window.umami.track('navigation', {
              section: sectionName,
              url: href
            });
          }
          
          console.log(`🧭 Navigation: ${sectionName}`);
        });
      });
    };

    /**
      * Setup section tracking (Intersection Observer)
      */
    const setupSectionTracking = (ana: any) => {
      const sections = document.querySelectorAll('[id^="section-"], #work, #stack, #experience, #contact');
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const sectionId = (entry.target as HTMLElement).id;
            const sectionTitle = (entry.target as HTMLElement).querySelector('h2')?.textContent?.trim();
            
            if (sectionId) {
              ana.trackSectionView(sectionId);
              
              // Send to Umami
              if (typeof window.umami !== 'undefined') {
                window.umami.track('section_view', {
                  section_id: sectionId,
                  section_name: sectionTitle || sectionId
                });
              }
              
              console.log(`👁️ Section Viewed: ${sectionTitle} (#${sectionId})`);
            }
          }
        });
      }, { threshold: 0.3 });

      sections.forEach((section) => observer.observe(section));
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAll);
    } else {
      initAll();
    }
  }
</script>

<style>
  #webgl-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    pointer-events: none;
  }

  /* Hero */
  .hero-brutal {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: var(--space-xl) var(--space-md);
    gap: var(--space-xl);
    max-width: 1400px;
    margin: 0 auto;
  }

  .hero-content {
    flex: 1;
  }

  .hero-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
  }

  .hero-title {
    font-size: clamp(3rem, 10vw, var(--text-5xl));
    line-height: 0.85;
    margin-bottom: var(--space-md);
    color: var(--color-text);
    text-shadow: 4px 4px 0 var(--color-accent);
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
    max-width: 600px;
  }

  .hero-cta {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .hero-side {
    flex: 0 0 300px;
  }

  .stats-brutal {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .stat {
    border: var(--border-thick) solid var(--color-text);
    padding: var(--space-sm);
    background: var(--color-bg);
  }

  .stat-value {
    font-family: var(--font-header);
    font-size: var(--text-3xl);
    font-weight: 900;
    color: var(--color-accent);
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }

  /* Sections */
  .section-brutal {
    padding: var(--space-2xl) var(--space-md);
    max-width: 1400px;
    margin: 0 auto;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
    border-bottom: var(--border-thick) solid var(--color-accent);
    padding-bottom: var(--space-sm);
  }

  .section-number {
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: var(--color-accent-2);
    font-weight: 900;
  }

  .section-title {
    font-size: clamp(2.5rem, 6vw, var(--text-4xl));
    margin: 0;
  }

  /* About */
  .about-content {
    max-width: 900px;
  }

  .about-text {
    font-size: var(--text-lg);
    line-height: 1.6;
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .about-highlights {
    margin-top: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .highlight {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm);
    border-left: var(--border-thick) solid var(--color-accent);
  }

  .highlight-icon {
    font-size: var(--text-xl);
    color: var(--color-accent);
  }

  .highlight-text {
    font-family: var(--font-body);
    font-size: var(--text-base);
  }

  /* Projects */
  .projects-brutal {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .project-brutal {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-md);
    border: var(--border-thick) solid var(--color-text);
    background: var(--color-bg-alt);
    transition: all 0.2s ease;
  }

  .project-brutal:hover {
    transform: translate(-4px, -4px);
    box-shadow: 4px 4px 0 var(--color-accent);
    border-color: var(--color-accent);
  }

  .project-number {
    font-family: var(--font-body);
    font-size: var(--text-2xl);
    font-weight: 900;
    color: var(--color-accent-2);
    flex-shrink: 0;
  }

  .project-main {
    flex: 1;
  }

