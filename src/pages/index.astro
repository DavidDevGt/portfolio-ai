    year: '2026',
    link: 'https://music.kuraitachi.com/',
    metrics: '100% uptime'
  },
  {
    title: 'AI Infrastructure Orchestration',
    desc: 'Production-grade distributed systems for AI workloads. Model serving with dynamic resource allocation, automatic scaling, and fault tolerance. Built for reliability over coolness.',
    stack: ['Kubernetes', 'Prometheus', 'Go', 'Python'],
    year: '2025',
    metrics: 'Zero downtime'
