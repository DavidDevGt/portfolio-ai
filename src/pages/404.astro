---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const home = translatePath('/');
---

<Layout lang={lang} title={`404 — ${t('404.title')}`}>
  <Header />

  <main class="not-found-page">
    <div class="content">
      <span class="error-code">
        <span class="bracket">[</span>
        <span class="code">404</span>
        <span class="bracket">]</span>
      </span>
      <h1 class="title">{t('404.title')}</h1>
      <p class="description">{t('404.description')}</p>
      <div class="cta">
        <a href={home} class="btn-brutal btn-primary">{t('404.home')}</a>
        <a href={`${home}#work`} class="btn-brutal">{t('404.projects')}</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .not-found-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 100px 2rem 4rem;
    text-align: center;
  }

  .content {
    max-width: 500px;
  }

  .error-code {
    font-family: var(--font-body);
    font-size: 1.5rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25em;
    margin-bottom: 1.5rem;
  }

  .code {
    color: var(--color-cyan);
  }

  .title {
    font-family: var(--font-header);
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    margin-bottom: 1rem;
  }

  .description {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
