---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "David Vargas — AI Systems Engineer | ML Infrastructure & Real-time AI", 
  description = "AI Systems Engineer specializing in production ML infrastructure, model optimization, and real-time AI systems. Building scalable AI pipelines with PyTorch, TensorFlow, Go, and Kubernetes.",
  url = Astro.url
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://davidwebgt.com');

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "David Vargas",
  "givenName": "David",
  "familyName": "Vargas",
  "jobTitle": "AI Systems Engineer",
  "url": "https://davidwebgt.com",
  "description": description,
  "sameAs": [
    "https://github.com/DavidDevGt",
    "https://www.linkedin.com/in/jdavidvl/"
  ],
  "knowsAbout": [
    "Artificial Intelligence",
    "Machine Learning",
    "Deep Learning",
    "PyTorch",
    "TensorFlow",
    "CUDA",
    "Model Optimization",
    "MLOps",
    "Kubernetes",
    "Go",
    "Python",
    "Computer Vision",
    "Natural Language Processing",
    "Distributed Systems",
    "Real-time AI",
    "ML Infrastructure"
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="David Vargas" />
    <meta name="keywords" content="AI Systems Engineer, Machine Learning Infrastructure, ML Engineer, PyTorch, TensorFlow, Model Optimization, MLOps, Kubernetes, CUDA, Deep Learning, AI Infrastructure" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="English" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    
    <title>{title}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="David Vargas - AI Systems Engineer" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://davidwebgt.com/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="David Vargas - Ingeniero de Software especializado en desarrollo móvil y cloud" />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://davidwebgt.com/og-image.jpg" />
    <meta name="twitter:creator" content="@davidwebgt" />
    
    <link rel="sitemap" href="/sitemap-index.xml" />
    
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <slot />
  </body>
</html>