---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  url?: string;
}

const {
  title = "David Vargas — AI Systems Engineer | Self-Hosted AI & GPU Optimization",
  description = "Hire David Vargas, AI Systems Engineer from Guatemala with 3+ years experience in self-hosted AI, GPU optimization, and production ML infrastructure. Expert in building scalable AI systems like Kurai-Transcribe, KuraiMusik, and KurAI2Video. Available for consulting and development projects.",
  url = Astro.url
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://davidwebgt.com');

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "David Vargas",
  "givenName": "David",
  "familyName": "Vargas",
  "jobTitle": "AI Systems Engineer",
  "url": "https://davidwebgt.com",
  "description": description,
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "GT",
    "addressRegion": "Guatemala"
  },
  "sameAs": [
    "https://github.com/DavidDevGt",
    "https://www.linkedin.com/in/jdavidvl/"
  ],
  "hasOccupation": {
    "@type": "Occupation",
    "name": "AI Systems Engineer",
    "occupationLocation": {
      "@type": "Country",
      "name": "Guatemala"
    },
    "skills": "Self-hosted AI, GPU Optimization, ML Infrastructure, Production ML, Model Deployment",
    "experienceRequirements": "3+ years in AI/ML systems development"
  },
  "knowsAbout": [
    "AI Systems Engineering",
    "Machine Learning Infrastructure",
    "Self-Hosted AI Solutions",
    "GPU Optimization",
    "Production ML Deployment",
    "Faster-Whisper",
    "Speech Recognition",
    "Natural Language Processing",
    "Kubernetes Orchestration",
    "MLOps Platforms",
    "CUDA Programming",
    "PyTorch Frameworks",
    "TensorFlow Production",
    "FastAPI Development",
    "Go Programming",
    "Real-time AI Systems",
    "Distributed Computing",
    "Containerization",
    "CI/CD Pipelines",
    "Automated Testing",
    "Selenium WebDriver",
    "Java Automation",
    "Fintech Development",
    "ERP Systems",
    "Full Stack Development",
    "Android Development",
    "Kotlin Programming",
    "PostgreSQL Databases",
    "Redis Caching",
    "Docker Containers"
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What experience do you have in fintech development?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "I have experience developing financial systems including payment processing, transaction management, compliance frameworks, and financial data analytics. I've worked on secure API design, regulatory requirements, and high-availability systems for financial applications."
      }
    },
    {
      "@type": "Question",
      "name": "Why do you focus on self-hosted AI instead of cloud APIs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Self-hosted AI eliminates vendor lock-in and dramatically reduces costs. Cloud AI APIs can cost $15,000+ for 10,000 videos at $0.15-0.40 per second. The same infrastructure self-hosted costs $0 in API fees. Plus you get complete data sovereignty, custom optimizations, and the ability to scale without worrying about rate limits or service outages."
      }
    },
    {
      "@type": "Question",
      "name": "How do you optimize AI systems for production?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "I focus on GPU optimization, automated testing, and scalable infrastructure. This includes CUDA memory management, CI/CD pipelines for model deployment, comprehensive monitoring with Prometheus, and automated testing frameworks. My goal is systems that run 24/7, scale efficiently, and provide reliable AI capabilities without breaking the bank."
      }
    },
    {
       "@type": "Question",
       "name": "How do you approach AI integration in business applications?",
       "acceptedAnswer": {
         "@type": "Answer",
         "text": "I focus on practical AI integration that solves real business problems. Whether it's speech recognition, video generation, or predictive analytics, I build self-hosted solutions that maintain data privacy and give clients complete control. Kurai-Transcribe and KurAI2Video demonstrate how AI can enhance business workflows."
       }
    },
    {
      "@type": "Question",
      "name": "What testing frameworks and tools do you use for QA automation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "I work with Selenium WebDriver and Java for UI automation and tools like Jest and Pytest for unit testing. For API testing, I use Postman. My CI/CD experience includes GitHub Actions, Jenkins, and GitLab CI with automated testing pipelines."
      }
    },
    {
      "@type": "Question",
      "name": "What makes you qualified for AI systems engineering roles?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "With 3+ years of experience in AI/ML infrastructure, I specialize in building production-ready systems that scale. My expertise includes self-hosted AI deployment, GPU optimization with CUDA, MLOps platforms, and real-time AI systems. I've successfully delivered projects like Kurai-Transcribe processing millions of minutes monthly and KurAI2Video saving $35K+ in cloud API costs."
      }
    },
    {
      "@type": "Question",
      "name": "How do you handle GPU memory management in AI applications?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "I implement advanced GPU memory management techniques including semaphore-based VRAM allocation, dynamic CPU↔GPU offloading, and memory pooling to prevent OOM errors. This ensures stable performance in production environments, especially for large models like Wan 2.1 T2V-1.3B used in video generation systems."
      }
    },
    {
      "@type": "Question",
      "name": "What are your strengths in full-stack development?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "I excel in full-stack development with strong backend skills in Python, FastAPI, and Go, combined with frontend experience in modern JavaScript frameworks. My approach emphasizes scalable architecture, robust API design, and seamless integration between frontend and backend systems, as demonstrated in my fintech and ERP projects."
      }
    }
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "David Vargas - AI Systems Engineer",
  "url": "https://davidwebgt.com",
  "description": "Portfolio of David Vargas, AI Systems Engineer from Guatemala specializing in self-hosted ML infrastructure and real-time AI systems.",
  "inLanguage": "es-GT",
  "author": {
    "@type": "Person",
    "name": "David Vargas",
    "url": "https://davidwebgt.com"
  }
};
---

<!DOCTYPE html>
