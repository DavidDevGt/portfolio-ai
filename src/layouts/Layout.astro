    <meta name="description" content={description} />
    <meta name="author" content="David Vargas" />
    <meta name="keywords" content="AI Systems Engineer, hire AI engineer, ML infrastructure consultant, self-hosted AI expert, GPU optimization specialist, production ML engineer, Kurai-Transcribe, KurAI2Video, Faster-Whisper, Kubernetes, MLOps, CUDA, PyTorch, TensorFlow, real-time AI systems, Guatemala developer, machine learning pipeline, AI consulting" />
    <meta name="robots" content="index, follow" />
