---
import '../styles/global.css';
import RadioWidget from '../components/RadioWidget.astro';
import { getLangFromUrl, useTranslations, languages, defaultLang, type Lang } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = t('site.title'),
  description = t('site.description'),
} = Astro.props;

// Single source of truth for the production domain — set via `site` in astro.config.mjs.
const siteURL = Astro.site ?? new URL('https://ai.davidwebgt.com');
const canonicalURL = new URL(Astro.url.pathname, siteURL);

const localeMap: Record<Lang, string> = { en: 'en_US', es: 'es_GT' };
const ogLocale = localeMap[lang];
const alternateLangs = Object.keys(languages) as Lang[];
// Path with any locale prefix stripped, used to build hreflang alternates for every locale.
const basePath = (lang === defaultLang ? Astro.url.pathname : Astro.url.pathname.replace(`/${lang}`, '')) || '/';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "David Vargas",
  "givenName": "David",
  "familyName": "Vargas",
  "jobTitle": "AI Software Engineer",
  "url": siteURL.href,
  "description": description,
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "GT",
    "addressRegion": "Guatemala"
  },
  "sameAs": [
    "https://github.com/DavidDevGt",
    "https://www.linkedin.com/in/jdavidvl/"
  ],
  "hasOccupation": {
    "@type": "Occupation",
    "name": "Software Engineer",
    "occupationLocation": {
      "@type": "Country",
      "name": "Guatemala"
    },
    "skills": "Self-hosted AI, GPU Optimization, ML Infrastructure, Production ML, Model Deployment",
    "experienceRequirements": "3+ years in AI/ML systems development"
  },
  "knowsAbout": [
    "AI Systems Engineering",
    "Machine Learning Infrastructure",
    "Self-Hosted AI Solutions",
    "GPU Optimization",
    "Production ML Deployment",
    "Faster-Whisper",
    "Speech Recognition",
    "Natural Language Processing",
    "Kubernetes Orchestration",
    "MLOps Platforms",
    "CUDA Programming",
    "PyTorch Frameworks",
    "TensorFlow Production",
    "FastAPI Development",
    "Go Programming",
    "Real-time AI Systems",
    "Distributed Computing",
    "Containerization",
    "CI/CD Pipelines",
    "Automated Testing",
    "Selenium WebDriver",
    "Java Automation",
    "Fintech Development",
    "Full Stack Development",
    "PostgreSQL Databases",
    "Redis Caching",
    "Docker Containers"
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What experience do you have in fintech development?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "I have experience developing financial systems including payment processing, transaction management, compliance frameworks, and financial data analytics. I've worked on secure API design, regulatory requirements, and high-availability systems for financial applications."
      }
    },
    {
      "@type": "Question",
      "name": "Why do you focus on self-hosted AI instead of cloud APIs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Self-hosted AI eliminates vendor lock-in and dramatically reduces costs. Cloud AI APIs can cost $15,000+ for 10,000 videos at $0.15-0.40 per second. The same infrastructure self-hosted costs $0 in API fees. Plus you get complete data sovereignty, custom optimizations, and the ability to scale without worrying about rate limits or service outages."
      }
    },
    {
      "@type": "Question",
      "name": "How do you optimize AI systems for production?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "I focus on GPU optimization, automated testing, and scalable infrastructure. This includes CUDA memory management, CI/CD pipelines for model deployment, comprehensive monitoring with Prometheus, and automated testing frameworks. My goal is systems that run 24/7, scale efficiently, and provide reliable AI capabilities without breaking the bank."
      }
    },
    {
       "@type": "Question",
       "name": "How do you approach AI integration in business applications?",
       "acceptedAnswer": {
         "@type": "Answer",
         "text": "I focus on practical AI integration that solves real business problems. Whether it's speech recognition, audio processing, or generative AI, I build self-hosted solutions that maintain data privacy and give clients complete control. Kurai-Transcribe and KuraiMusik demonstrate how AI can enhance business workflows."
       }
    },
    {
      "@type": "Question",
      "name": "What testing frameworks and tools do you use for QA automation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "I work with Selenium WebDriver and Java for UI automation and tools like Jest and Pytest for unit testing. For API testing, I use Postman. My CI/CD experience includes GitHub Actions, Jenkins, and GitLab CI with automated testing pipelines."
      }
    },
    {
      "@type": "Question",
      "name": "What makes you qualified for senior software engineering roles?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "With 3+ years of experience in software development, I specialize in building production-ready systems that scale. My expertise includes full-stack development, API design, and real-time applications. I've successfully delivered projects like Kurai-Transcribe, processing millions of minutes of audio monthly, and KuraiMusik, running 24/7 with zero human intervention."
      }
    },
    {
      "@type": "Question",
      "name": "How do you handle GPU memory management in AI applications?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "I implement advanced GPU memory management techniques including semaphore-based VRAM allocation, dynamic CPU↔GPU offloading, and memory pooling to prevent OOM errors. This ensures stable performance in production environments, such as Kurai-Transcribe, which processes millions of minutes of audio monthly under strict VRAM constraints."
      }
    },
    {
      "@type": "Question",
      "name": "What are your strengths in full-stack development?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "I excel in full-stack development with strong backend skills in Python, FastAPI, and Go, combined with frontend experience in modern JavaScript frameworks. My approach emphasizes scalable architecture, robust API design, and seamless integration between frontend and backend systems, as demonstrated in my fintech and ERP projects."
      }
    }
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "David Vargas - Software Engineer",
  "url": siteURL.href,
  "description": "Portfolio of David Vargas, Senior Software Engineer from Guatemala specializing in self-hosted ML infrastructure and real-time AI systems.",
  "inLanguage": ogLocale.replace('_', '-'),
  "author": {
    "@type": "Person",
    "name": "David Vargas",
    "url": siteURL.href
  }
};

const metaLanguageName: Record<Lang, string> = { en: 'English', es: 'Spanish' };
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="David Vargas" />
    <meta name="keywords" content="Senior AI Systems Engineer, Senior Software Engineer, hire AI engineer, ML infrastructure consultant, self-hosted AI expert, GPU optimization specialist, production ML engineer, Kurai-Transcribe, KuraiMusik, Faster-Whisper, Kubernetes, MLOps, CUDA, PyTorch, TensorFlow, real-time AI systems, Guatemala developer, machine learning pipeline, AI consulting" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content={metaLanguageName[lang]} />
    <meta name="geo.region" content="GT" />
    <meta name="geo.placename" content="Guatemala" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#000000" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    {alternateLangs.map((altLang) => (
      <link rel="alternate" hreflang={altLang} href={new URL(altLang === defaultLang ? basePath : `/${altLang}${basePath}`, siteURL)} />
    ))}

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="David Vargas - Software Engineer" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={new URL('/og-image.png', siteURL)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="David Vargas - Software Engineer from Guatemala specializing in self-hosted ML infrastructure" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', siteURL)} />
    <meta name="twitter:site" content="@davidwebgt" />
    <meta name="twitter:creator" content="@davidwebgt" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- Umami Cloud Analytics -->
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="15245736-2d0c-4539-8099-16a502ec5c33"></script>
  </head>
  <body>
    <slot />
    <RadioWidget />
  </body>
</html>