---
const currentYear = new Date().getFullYear();

const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/DavidDevGt', icon: 'GH' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/jdavidvl', icon: 'LI' },
  { label: 'Email', href: 'mailto:josuedavidvl18@gmail.com', icon: '@' },
];
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-left">
      <p class="footer-copy">
        <span class="footer-bracket">&lt;</span>
        {currentYear}
        <span class="footer-bracket">/&gt;</span>
        David Vargas — Ingeniero de Software
      </p>
      <p class="footer-location">
        📍 Guatemala
      </p>
    </div>
    
    <div class="footer-right">
      <div class="social-links">
        {socialLinks.map((link) => (
          <a 
            href={link.href} 
            class="social-link" 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label={link.label}
          >
            <span class="social-icon">{link.icon}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 3px solid var(--color-border);
    padding: 2rem;
    margin-top: 4rem;
    background: var(--color-bg-alt);
  }

  .footer-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-copy {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.25em;
  }

  .footer-bracket {
    color: var(--color-cyan);
    font-weight: 700;
  }

  .footer-location {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0.5rem 0 0 0;
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }

  .social-link {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    transition: all 0.2s ease;
  }

  .social-link:hover {
    color: var(--color-bg);
    background: var(--color-cyan);
    border-color: var(--color-cyan);
  }

  .social-link:focus-visible {
    outline: 2px solid var(--color-cyan);
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>