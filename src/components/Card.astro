---
interface Props {
  class?: string;
  hoverable?: boolean;
}

const { class: className = '', hoverable = true } = Astro.props;
---

<div class:list={['card', { 'card-hoverable': hoverable }, className]}>
  <slot />
</div>

<style>
  .card {
    background: var(--color-bg-alt);
    border: 3px solid var(--color-border);
    padding: 1.5rem;
    position: relative;
  }

  .card-hoverable::before {
    content: '';
    position: absolute;
    top: -3px;
    left: -3px;
    right: -3px;
    bottom: -3px;
    border: 3px solid var(--color-cyan);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .card-hoverable:hover::before {
    opacity: 1;
  }
</style>