---
const navItems = [
  { label: 'EXPERIENCE', href: '/#experience' },
  { label: 'WORK', href: '/#work' },
  { label: 'STACK', href: '/#stack' },
  { label: 'CONTACT', href: '/#contact' },
];
---

<header>
  <nav class="nav-brutal" aria-label="Navegación principal">
    <div class="nav-inner">
      <a href="/" class="logo-brutal">&lt;DV/&gt;</a>
      <div class="nav-links">
        {navItems.map((item) => (
          <a href={item.href} class="nav-link">{item.label}</a>
        ))}
      </div>
    </div>
  </nav>
</header>

<style>
  .nav-brutal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: var(--color-bg);
    border-bottom: var(--border-thick) solid var(--color-accent);
  }

  .nav-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--space-sm) var(--space-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo-brutal {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-weight: 900;
    color: var(--color-accent);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: var(--space-md);
  }

  .nav-link {
    font-family: var(--font-header);
    font-size: var(--text-sm);
    font-weight: 900;
    color: var(--color-text);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: var(--border-medium) solid transparent;
    transition: all 0.15s ease;
  }

  .nav-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 1024px) {
    .nav-inner {
      padding: var(--space-sm) var(--space-md);
    }

    .nav-links {
      gap: var(--space-md);
    }
  }

  @media (max-width: 968px) {
    .nav-links {
      gap: var(--space-sm);
    }

    .nav-link {
      padding: 0.5rem 0.75rem;
      font-size: 0.7rem;
      border-width: var(--border-medium);
    }
  }

  @media (max-width: 768px) {
    .nav-brutal {
      border-bottom-width: var(--border-medium);
    }

    .nav-inner {
      padding: var(--space-sm) var(--space-sm);
      gap: var(--space-sm);
    }

    .logo-brutal {
      font-size: var(--text-lg);
    }

    .nav-links {
      gap: 0.5rem;
    }

    .nav-link {
      padding: 0.35rem 0.5rem;
      font-size: 0.65rem;
      border: var(--border-thin) solid transparent;
    }
  }

  @media (max-width: 640px) {
    .nav-brutal {
      border-bottom-width: 2px;
    }

    .nav-inner {
      padding: 0.6rem 0.75rem;
      flex-wrap: wrap;
    }

    .logo-brutal {
      font-size: var(--text-base);
      order: 1;
    }

    .nav-links {
      gap: 0.25rem;
      order: 3;
      width: 100%;
      margin-top: 0.5rem;
      flex-wrap: wrap;
    }

    .nav-link {
      padding: 0.3rem 0.4rem;
      font-size: 0.6rem;
      flex: 1 1 auto;
      min-width: 60px;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .nav-brutal {
      border-bottom-width: 2px;
    }

    .nav-inner {
      padding: 0.5rem;
      flex-direction: column;
      gap: 0.5rem;
    }

    .logo-brutal {
      font-size: 0.9rem;
      width: 100%;
      text-align: center;
    }

    .nav-links {
      width: 100%;
      gap: 0.15rem;
      margin-top: 0;
    }

    .nav-link {
      padding: 0.25rem 0.3rem;
      font-size: 0.55rem;
      min-width: 50px;
    }
  }

  @media (max-width: 360px) {
    .nav-link {
      font-size: 0.5rem;
      padding: 0.2rem 0.25rem;
    }
  }
</style>
