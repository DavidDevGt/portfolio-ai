---
import { languages, defaultLang, getLangFromUrl, useTranslations, type Lang } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const basePath = (lang === defaultLang ? Astro.url.pathname : Astro.url.pathname.replace(`/${lang}`, '')) || '/';

const langEntries = Object.keys(languages) as Lang[];
---

<div class="lang-switcher" role="group" aria-label={t('lang.switch.aria')}>
  {langEntries.map((entry) => {
    const href = entry === defaultLang ? basePath : `/${entry}${basePath}`;
    const isActive = entry === lang;
    return (
      <a
        href={href}
        class="lang-link"
        aria-current={isActive ? 'true' : undefined}
        data-active={isActive ? '' : undefined}
      >
        {entry.toUpperCase()}
      </a>
    );
  })}
</div>

<style>
  .lang-switcher {
    display: flex;
    gap: 0.25rem;
    border: var(--border-medium) solid var(--color-text);
    padding: 0.2rem;
  }

  .lang-link {
    font-family: var(--font-header);
    font-size: var(--text-xs);
    font-weight: 900;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    transition: all 0.15s ease;
  }

  .lang-link:hover {
    color: var(--color-accent);
  }

  .lang-link[data-active] {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  @media (max-width: 640px) {
    .lang-switcher {
      border-width: 2px;
    }

    .lang-link {
      font-size: 0.6rem;
      padding: 0.25rem 0.5rem;
    }
  }
</style>
