---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Scene3D from '../components/Scene3D.astro';
import { useTranslations, useContent, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { projects, skills, experience, education } = useContent(lang);
---

<Layout lang={lang}>
  <Scene3D canvasId="webgl-canvas" />

  <Header />

  <main>
    <!-- Hero Section -->
    <section class="hero-brutal" aria-label={t('hero.label')}>
      <div class="hero-content">
        <div class="hero-label">
          <span class="bracket">[</span>{t('hero.label')}<span class="bracket">]</span>
        </div>
        <h1 class="hero-title">
          {t('hero.title.line1')}<br />
          {t('hero.title.line2')}<br />
          {t('hero.title.line3')}
        </h1>
        <div class="hero-subtitle">
          {t('hero.subtitle')}
        </div>
        <div class="hero-cta">
          <a href="#work" class="btn-brutal btn-primary">{t('hero.cta.work')}</a>
          <a
            href="https://github.com/DavidDevGt"
            target="_blank"
            rel="noopener"
            class="btn-brutal">{t('hero.cta.github')}</a
          >
        </div>
      </div>
      <div class="hero-side">
        <div class="stats-brutal">
          <div class="stat">
            <div class="stat-value">{t('hero.stats.years.value')}</div>
            <div class="stat-label">{t('hero.stats.years.label')}</div>
          </div>
          <div class="stat">
            <div class="stat-value">{t('hero.stats.study.value')}</div>
            <div class="stat-label">{t('hero.stats.study.label')}</div>
          </div>
          <div class="stat">
            <div class="stat-value">{t('hero.stats.shipped.value')}</div>
            <div class="stat-label">{t('hero.stats.shipped.label')}</div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section class="section-brutal about-section">
      <div class="section-header">
        <span class="section-number">{t('about.sectionNumber')}</span>
        <h2 class="section-title">{t('about.title')}</h2>
      </div>
      <div class="about-content">
        <p class="about-text">{t('about.p1')}</p>
        <p class="about-text">{t('about.p2')}</p>
        <p class="about-text">{t('about.p3')}</p>
        <div class="about-highlights">
          <div class="highlight">
            <div class="highlight-icon">▲</div>
            <div class="highlight-text">{t('about.highlight1')}</div>
          </div>
          <div class="highlight">
            <div class="highlight-icon">▲</div>
            <div class="highlight-text">{t('about.highlight2')}</div>
          </div>
          <div class="highlight">
            <div class="highlight-icon">▲</div>
            <div class="highlight-text">{t('about.highlight3')}</div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Experience Section -->
  <section class="section-brutal" id="experience">
    <div class="section-header">
      <span class="section-number">{t('experience.sectionNumber')}</span>
      <h2 class="section-title">{t('experience.title')}</h2>
    </div>
    <div class="experience-timeline">
      {
        experience.map((exp) => (
          <div class="experience-item">
            <div class="experience-header">
              <h3 class="experience-role">{exp.role}</h3>
              <div class="experience-meta">
                <span class="experience-company">{exp.company}</span>
                <span class="experience-period">{exp.period}</span>
              </div>
            </div>
            <ul class="experience-achievements">
              {exp.achievements.map((achievement) => (
                <li class="achievement-item">
                  <span class="achievement-bullet">▸</span>
                  {achievement}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Projects Section -->
  <section class="section-brutal" id="work">
    <div class="section-header">
      <span class="section-number">{t('work.sectionNumber')}</span>
      <h2 class="section-title">{t('work.title')}</h2>
    </div>
    <div class="projects-brutal">
       {
         projects.map((project, idx) => (
           <article class="project-brutal" data-project-id={`project_${idx + 1}`} data-project-name={project.title}>
             <div class="project-number">
               [{String(idx + 1).padStart(2, "0")}]
             </div>
            <div class="project-main">
              <div class="project-header">
                <h3 class="project-title">{project.title}</h3>
                <span class="project-year">{project.year}</span>
              </div>
              <p class="project-desc">{project.desc}</p>
              <div class="project-stack">
                {project.stack.map((tech) => (
                  <span class="tech-tag">{tech}</span>
                ))}
              </div>
              {project.link && (
                <div class="project-footer">
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project-link"
                  >
                    {t('work.viewLive')}
                  </a>
                  <span class="project-metric">{project.metrics}</span>
                </div>
              )}
              {!project.link && project.metrics && (
                <div class="project-footer">
                  <span class="project-metric">{project.metrics}</span>
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Stack Section -->
  <section class="section-brutal" id="stack">
    <div class="section-header">
      <span class="section-number">{t('stack.sectionNumber')}</span>
      <h2 class="section-title">{t('stack.title')}</h2>
    </div>
    <div class="stack-grid">
      {
        Object.entries(skills).map(([category, techs]) => (
          <div class="stack-category">
            <h3 class="stack-category-title">{category}</h3>
            <ul class="stack-list">
              {techs.map((tech) => (
                <li class="stack-item">
                  <span class="stack-bullet">▸</span>
                  {tech}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Education Section -->
  <section class="section-brutal" id="education">
    <div class="section-header">
      <span class="section-number">{t('education.sectionNumber')}</span>
      <h2 class="section-title">{t('education.title')}</h2>
    </div>
    <div class="experience-timeline">
      {
        education.map((edu) => (
          <div class="experience-item">
            <div class="experience-header">
              <h3 class="experience-role">{edu.degree}</h3>
              <div class="experience-meta">
                <span class="experience-company">{edu.institution}</span>
                <span class="experience-period">{edu.period} · {edu.status}</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section-brutal contact-section" id="contact">
    <div class="section-header">
      <span class="section-number">{t('contact.sectionNumber')}</span>
      <h2 class="section-title">{t('contact.title')}</h2>
    </div>
    <div class="contact-content">
      <div class="contact-text">
        <p>{t('contact.p1')}</p>
        <p>{t('contact.p2')}</p>
        <p>{t('contact.p3')}</p>
      </div>
      <div class="contact-links">
        <a
          href="https://github.com/DavidDevGt"
          target="_blank"
          rel="noopener"
          class="contact-link"
        >
          <span class="link-label">{t('contact.github')}</span>
          <span class="link-arrow">→</span>
        </a>
        <a
          href="https://www.linkedin.com/in/jdavidvl/"
          target="_blank"
          rel="noopener"
          class="contact-link"
        >
          <span class="link-label">{t('contact.linkedin')}</span>
          <span class="link-arrow">→</span>
        </a>
        <a
          href="#"
          id="email-link"
          class="contact-link"
          rel="nofollow"
          aria-label={t('contact.email')}
        >
          <span class="link-label">{t('contact.email')}</span>
          <span class="link-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
</Layout>

<Footer />

<script>
  import { GSAPAnimations } from '../scripts/gsap-animations';
  import { UmamiBatcher, logUmamiDetails, checkUmamiHealth } from '../scripts/analytics-umami';

  // Email armado en tiempo de ejecución para no exponerlo en el HTML fuente
  // (evita el scraping automático de bots que buscan texto tipo "@" en el markup)
  const revealEmail = () => {
    const emailLink = document.getElementById('email-link') as HTMLAnchorElement | null;
    if (!emailLink) return;
    const address = atob('am9zdWVkYXZpZHZsMThAZ21haWwuY29t');
    emailLink.href = `mailto:${address}`;
  };

  if (typeof window !== "undefined") {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", revealEmail);
    } else {
      revealEmail();
    }
  }

  let gsapAnimations: GSAPAnimations | null = null;
  let analytics: any = null;
  let umamiBatcher: any = null;

  // Initialize everything when DOM is ready
  if (typeof window !== "undefined") {
    const initAll = async () => {
      try {
        // Initialize Umami Batcher first (antes de analytics)
        umamiBatcher = new UmamiBatcher();

        // Initialize Analytics
        const { Analytics } = await import('../scripts/analytics');
        analytics = new Analytics(true);
        analytics.trackPageView(window.location.pathname);

        // Log Umami status
        setTimeout(() => {
          const health = checkUmamiHealth();
          if (health.loaded) {
            console.log('✅ [Umami] Cloud Analytics Connected');
            logUmamiDetails();
          } else {
            console.warn('⚠️ [Umami] Script still loading...');
          }
        }, 2000);

        // Initialize GSAP animations
        gsapAnimations = new GSAPAnimations();
        gsapAnimations.init();

        // Setup analytics event listeners
        setupAnalyticsTracking(analytics);
        setupScrollTracking(analytics);
        setupProjectTracking(analytics);
        setupNavigationTracking(analytics);
        setupSectionTracking(analytics);
      } catch (error) {
        console.warn("Failed to initialize:", error);
      }
    };

    /**
      * Setup tracking para clicks generales
      */
    const setupAnalyticsTracking = (ana: any) => {
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;

        // Track CTA buttons
        if (target.classList.contains('btn-brutal') || target.classList.contains('btn-primary')) {
          const ctaText = target.textContent?.trim() || 'button_click';
          ana.trackCTA(ctaText, 'click');

          // Send to Umami
          const event = ana.getEvents()?.find((ev: any) => ev.type === 'cta_interaction');
          if (event && umamiBatcher) {
            umamiBatcher.addEvent(event);
          }
        }

        // Track external links
        if (target.tagName === 'A') {
          const href = (target as HTMLAnchorElement).href;
          if (href && !href.includes(window.location.hostname)) {
            ana.trackExternalLink(href, target.textContent?.trim() || 'link');

            // Send to Umami
            const event = ana.getEvents()?.find((ev: any) => ev.type === 'external_link');
            if (event && umamiBatcher) {
              umamiBatcher.addEvent(event);
            }
          }
        }

        // Track general clicks for debugging
        if (target.id) {
          ana.trackClick(target, 'element_click');
        }
      }, true);
    };

    /**
      * Setup scroll depth tracking
      */
    const setupScrollTracking = (ana: any) => {
      let scrollTimeout: NodeJS.Timeout;

      window.addEventListener('scroll', () => {
        clearTimeout(scrollTimeout);

        // Calculate scroll depth percentage
        const windowHeight = window.innerHeight;
        const documentHeight = document.documentElement.scrollHeight;
        const scrollTop = window.scrollY;

        const scrollDepth = Math.round(
          ((scrollTop + windowHeight) / documentHeight) * 100
        );

        ana.trackScrollDepth(scrollDepth);

        // Send to Umami on milestone
        if (scrollDepth === 25 || scrollDepth === 50 || scrollDepth === 75 || scrollDepth === 100) {
          if (typeof window.umami !== 'undefined') {
            window.umami.track('scroll_depth', { depth: scrollDepth, percentage: `${scrollDepth}%` });
          }
        }

        // Debounce logging
        scrollTimeout = setTimeout(() => {
          console.log(`📊 Scroll Depth: ${scrollDepth}%`, {
            scrollTop,
            windowHeight,
            documentHeight,
          });
        }, 1000);
      }, { passive: true });
    };

    /**
      * Setup project click tracking
      */
    const setupProjectTracking = (ana: any) => {
      const projectCards = document.querySelectorAll('[data-project-id]');

      projectCards.forEach((card) => {
        const projectId = card.getAttribute('data-project-id');
        const projectName = card.getAttribute('data-project-name');

        // Track card click
        card.addEventListener('click', () => {
          if (projectId && projectName) {
            ana.trackProjectClick(projectId, projectName, 'card_click');

            // Send to Umami
            if (typeof window.umami !== 'undefined') {
              window.umami.track('project_click', {
                project_id: projectId,
                project_name: projectName,
                action: 'card_click'
              });
            }

            console.log(`🎯 Project Clicked: ${projectName} (${projectId})`);
          }
        });

        // Track project link click
        const projectLink = card.querySelector('.project-link');
        if (projectLink) {
          projectLink.addEventListener('click', (e) => {
            e.stopPropagation();
            if (projectId && projectName) {
              ana.trackProjectClick(projectId, projectName, 'view_live_click');
              const href = (projectLink as HTMLAnchorElement).href;
              ana.trackExternalLink(href, `${projectName}_view_live`);

              // Send to Umami
              if (typeof window.umami !== 'undefined') {
                window.umami.track('project_click', {
                  project_id: projectId,
                  project_name: projectName,
                  action: 'view_live_click'
                });
                window.umami.track('outbound_link', {
                  url: href,
                  domain: new URL(href).hostname,
                  label: `${projectName}_view_live`
                });
              }

              console.log(`🔗 Project Link Clicked: ${projectName} → ${href}`);
            }
          });
        }
      });
    };

    /**
      * Setup navigation link tracking
      */
    const setupNavigationTracking = (ana: any) => {
      const navLinks = document.querySelectorAll('.nav-link');

      navLinks.forEach((link) => {
        link.addEventListener('click', () => {
          const href = (link as HTMLAnchorElement).href;
          const sectionName = link.textContent?.trim() || 'navigation';
          ana.trackEvent('navigation', 'click', sectionName, { href });

          // Send to Umami
          if (typeof window.umami !== 'undefined') {
            window.umami.track('navigation', {
              section: sectionName,
              url: href
            });
          }

          console.log(`🧭 Navigation: ${sectionName}`);
        });
      });
    };

    /**
      * Setup section tracking (Intersection Observer)
      */
    const setupSectionTracking = (ana: any) => {
      const sections = document.querySelectorAll('[id^="section-"], #work, #stack, #experience, #contact');

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const sectionId = (entry.target as HTMLElement).id;
            const sectionTitle = (entry.target as HTMLElement).querySelector('h2')?.textContent?.trim();

            if (sectionId) {
              ana.trackSectionView(sectionId);

              // Send to Umami
              if (typeof window.umami !== 'undefined') {
                window.umami.track('section_view', {
                  section_id: sectionId,
                  section_name: sectionTitle || sectionId
                });
              }

              console.log(`👁️ Section Viewed: ${sectionTitle} (#${sectionId})`);
            }
          }
        });
      }, { threshold: 0.3 });

      sections.forEach((section) => observer.observe(section));
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAll);
    } else {
      initAll();
    }
  }
</script>

<style>
  /* Hero */
  .hero-brutal {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: var(--space-xl) var(--space-md);
    gap: var(--space-xl);
    max-width: 1400px;
    margin: 0 auto;
  }

  .hero-content {
    flex: 1;
  }

  .hero-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
  }

  .hero-title {
    font-size: clamp(3rem, 10vw, var(--text-5xl));
    line-height: 0.85;
    margin-bottom: var(--space-md);
    color: var(--color-text);
    text-shadow: 4px 4px 0 var(--color-accent);
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
    max-width: 600px;
  }

  .hero-cta {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .hero-side {
    flex: 0 0 300px;
  }

  .stats-brutal {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .stat {
    border: var(--border-thick) solid var(--color-text);
    padding: var(--space-sm);
    background: var(--color-bg);
  }

  .stat-value {
    font-family: var(--font-header);
    font-size: var(--text-3xl);
    font-weight: 900;
    color: var(--color-accent);
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }

  /* Sections */
  .section-brutal {
    padding: var(--space-2xl) var(--space-md);
    max-width: 1400px;
    margin: 0 auto;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
    border-bottom: var(--border-thick) solid var(--color-accent);
    padding-bottom: var(--space-sm);
  }

  .section-number {
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: var(--color-accent-2);
    font-weight: 900;
  }

  .section-title {
    font-size: clamp(2.5rem, 6vw, var(--text-4xl));
    margin: 0;
  }

  /* About */
  .about-content {
    max-width: 900px;
  }

  .about-text {
    font-size: var(--text-lg);
    line-height: 1.6;
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .about-highlights {
    margin-top: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .highlight {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm);
    border-left: var(--border-thick) solid var(--color-accent);
  }

  .highlight-icon {
    font-size: var(--text-xl);
    color: var(--color-accent);
  }

  .highlight-text {
    font-family: var(--font-body);
    font-size: var(--text-base);
  }

  /* Projects */
  .projects-brutal {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .project-brutal {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-md);
    border: var(--border-thick) solid var(--color-text);
    background: var(--color-bg-alt);
    transition: all 0.2s ease;
  }

  .project-brutal:hover {
    transform: translate(-4px, -4px);
    box-shadow: 4px 4px 0 var(--color-accent);
    border-color: var(--color-accent);
  }

  .project-number {
    font-family: var(--font-body);
    font-size: var(--text-2xl);
    font-weight: 900;
    color: var(--color-accent-2);
    flex-shrink: 0;
  }

  .project-main {
    flex: 1;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-sm);
  }

  .project-title {
    font-size: var(--text-xl);
    margin: 0;
  }

  .project-year {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-weight: 700;
  }

  .project-desc {
    font-size: var(--text-base);
    line-height: 1.5;
    margin-bottom: var(--space-sm);
    color: var(--color-text-muted);
  }

  .project-stack {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .tech-tag {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    padding: 0.25rem 0.75rem;
    border: var(--border-thin) solid var(--color-text);
    color: var(--color-text);
    font-weight: 700;
  }

  .project-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: var(--border-thin) solid var(--color-text);
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .project-link {
    font-family: var(--font-header);
    font-size: var(--text-sm);
    font-weight: 900;
    color: var(--color-accent);
    text-decoration: none;
    transition: all 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-link:hover {
    color: var(--color-accent-3);
    transform: translateX(4px);
  }

  .project-metric {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent);
    padding: 0.25rem 0.75rem;
    border: var(--border-thin) solid var(--color-accent);
    background: rgba(0, 255, 0, 0.05);
  }

  /* Stack */
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-md);
  }

  .stack-category {
    border: var(--border-thick) solid var(--color-text);
    padding: var(--space-md);
    background: var(--color-bg-alt);
  }

  .stack-category-title {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-sm) 0;
    color: var(--color-accent);
  }

  .stack-list {
    list-style: none;
  }

  .stack-item {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    padding: 0.5rem 0;
    border-bottom: var(--border-thin) solid var(--color-text);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stack-item:last-child {
    border-bottom: none;
  }

  .stack-bullet {
    color: var(--color-accent);
    font-weight: 900;
  }

  /* Experience */
  .experience-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .experience-item {
